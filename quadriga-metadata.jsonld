  "hasPart": [
    {
      "@type": "LearningResource",
      "name": "Filmanalyse und automatisierte Annotation",
      "description": "Verschiedene Herangehensweisen an Filmanalyse werden dargestellt und der Begriff Annotation definiert. Es wird geklärt, was unter automatisierter Annotation verstanden werden kann. Quantitative Ansätze in der Filmwissenschaft werden vorgestellt und mögliche Fragestellungen für die Fallstudie entwickelt.",
      "url": "https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-4/filmanalyse/einleitung.html",
      "timeRequired": "PT1H",
      "teaches": "Filmanalyse und automatisierte Annotation",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Die Rolle von Annotationen für filmanalytische Prozesse kann dargestellt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 3 Anwenden | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Quantitative Ansätze in der Filmwissenschaft können beurteilt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 4.1 Datenanalyse | Bloom's: 5 Bewerten | Data Flow: 4 Analyse"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Mögliche Einsatzbereiche automatisierter Filmannotation können skizziert werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 2 Verstehen | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Eine Fragestellung zur quantitativen Filmanalyse kann formuliert werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: nicht anwendbar | Bloom's: 2 Verstehen | Data Flow: nicht anwendbar"
        }
      ]
    },
    {
      "@type": "LearningResource",
      "name": "Computer Vision für die Filmanalyse",
      "description": "Die Funktionsweisen von Computer Vision werden dargestellt und deren Einsatzmöglichkeiten für die filmanalytische Praxis ausgelotet. Grundlegende Begriffe wie Machine Learning, Algorithmus oder Modell werden geklärt und welche Rolle Schwellenwerte in diesem Themenbereich spielen. Im Kapitel werden zudem die Möglichkeiten und Grenzen von Computer Vision für die Filmanalyse kritisch reflektiert.",
      "url": "https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-4/vision/einleitung.html",
      "timeRequired": "PT1H10M",
      "teaches": "Computer Vision für die Filmanalyse",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Die grundlegende Funktionsweise von Computer Vision kann beschrieben werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 4.1 Datenanalyse | Bloom's: 2 Verstehen | Data Flow: 4 Analyse"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Grundlegende Begriffe wie Machine Learning, Algorithmus und Modell können definiert werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 4.1 Datenanalyse | Bloom's: 1 Erinnern | Data Flow: 4 Analyse"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Die Funktion von Schwellenwerten kann erklärt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 4.1 Datenanalyse | Bloom's: 2 Verstehen | Data Flow: 4 Analyse"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Die Einsatzmöglichkeiten von Computer Vision für filmanalytische Aufgaben können benannt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 4.1 Datenanalyse | Bloom's: 1 Erinnern | Data Flow: 4 Analyse"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Die Möglichkeiten und Grenzen von Computer Vision Modellen können beurteilt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 4.1 Datenanalyse | Bloom's: 5 Bewerten | Data Flow: 4 Analyse"
        }
      ]
    },
    {
      "@type": "LearningResource",
      "name": "Automatisierte Annotation von Filmen",
      "description": "Im Kapitel wird die automatisierte Annotation von Filmen wird anhand des Beispiels der Erkennung von Einstellungen und Figuren praktisch umgesetzt. Die Entwicklung des angewendeten Workflows wird dargestellt, auf die verwendeten Modelle eingegangen und die notwendigen technischen Voraussetzungen geklärt. Abschließend werden die erzeugten Annotationsdaten mit dem Filmanalysetool VIAN gesichtet und überprüft.",
      "url": "https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-4/annotation/einleitung.html",
      "timeRequired": "PT3H",
      "teaches": "Automatisierte Annotation von Filmen",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Geeignete Modelle für die Erkennung von Einstellungslängen und Figuren können ausgewählt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 3 Anwenden | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Es können geeignete Schwellenwerte für die Erkennung angewendet werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 3 Anwenden | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Die grundlegenden Schritte eines Python-Skripts zur Einstellungserkennung und zur Figurenerkennung werden verstanden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 2 Verstehen | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Die Python-Skripte können für eigene Annotations-Projekte modifiziert werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 6 Erschaffen | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Die Qualität der Annotationsergebnisse kann beurteilt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 5 Bewerten | Data Flow: 3 Management"
        }
      ]
    },
    {
      "@type": "LearningResource",
      "name": "Auswertung der Annotationsergebnisse",
      "description": "Im Kapitel werden die erzeugten automatisierten Annotationen ausgewertet. Nach der Vorstellung der Struktur der erhaltenen Annotationsdaten werden mithilfe von Jupyter Notebooks und Python Skripten verschiedene Visualisierungen zu den Annotationsdaten erstellt. Diese bilden die Grundlage einer explorativen Auswertung der Annotationsergebnisse.",
      "url": "https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-4/auswertung/einleitung.html",
      "timeRequired": "PT1H50M",
      "teaches": "Auswertung der automatisiert erstellten Annotationen",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
